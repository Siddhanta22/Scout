DATABASE_URL="file:./dev.db"
SCOUT_API_KEY="change-me"
PORT=3000
# FILING_TTL_DAYS=30

# Fit score: what a "good prospect" looks like for your club.
# FIT_MIN_REVENUE=250000
# FIT_MAX_REVENUE=5000000
# Comma-separated cause areas (see GET /api/causes); empty = any cause
# FIT_TARGET_CAUSES=Education,Health

# Local convenience: pre-fills the API key in the dashboard for requests from
# this machine. Remove (or set to false) on any deployed instance.
SCOUT_DEV_PREFILL=true
